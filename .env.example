# ---------------------------------------------------------------------------
# AI Business Builder — environment configuration
# Copy to .env.local for local dev, or add these in Vercel > Project > Settings
# > Environment Variables. These are SERVER-SIDE ONLY and are never sent to the
# browser. Do not prefix any of them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- AI provider (configure at least one; the app tells you if none are set) ---

# Anthropic (recommended). Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-sonnet-5
ANTHROPIC_MODEL=

# OpenAI. Get a key: https://platform.openai.com/
OPENAI_API_KEY=
# Optional model override. Default: gpt-4.1
OPENAI_MODEL=

# Any OpenAI-compatible endpoint (OpenRouter, Groq, Together, vLLM, Ollama...).
# Base URL should include /v1, e.g. https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Which provider to prefer when several are configured: anthropic | openai | compatible
AI_PROVIDER=

# --- Optional: live web research for the Validation Lab & Competitor Analysis ---
# Without one of these, the app clearly labels findings as AI inference and
# assumptions rather than verified research. It never fabricates sources.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
